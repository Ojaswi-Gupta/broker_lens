# BrokerLens Backend Configuration
# Copy this file to .env and adjust variables as needed.

APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & JWT Authentication
SECRET_KEY=brokerlens-insecure-dev-secret-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite default for zero-config evaluation
DATABASE_URL=sqlite:///./broker_lens.db
# PostgreSQL for production / cloud deployment (AWS ap-south-1 Mumbai)
# DATABASE_URL=postgresql://broker_user:broker_pass@localhost:5432/broker_lens_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini Vision API Key (Optional)
# If omitted or offline, the system seamlessly uses the built-in deterministic document extraction fallback
GEMINI_API_KEY=

# File Storage
DOCS_STORAGE_PATH=./static/docs

# DPDP Act 2023 Compliance
ENABLE_PII_MASKING_BY_DEFAULT=true
